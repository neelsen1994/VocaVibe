# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# auto = Anthropic if ANTHROPIC_API_KEY is set, then OpenAI, else offline demo mode.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
# claude-opus-5-5 ($4/$20 per 1M tokens) | claude-sonnet-5-5 ($2/$10) | claude-haiku-5-5 ($0.10/$0.50)
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = fewer thinking tokens = cheaper)
ANTHROPIC_EFFORT=medium

# Optional: only needed for OpenAI chat or OpenAI embeddings.
OPENAI_API_KEY=
